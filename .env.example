# ============================================
# toio-lab-web Configuration
# ============================================

# --- Claude Code Mode Settings ---
# HTTP server port (default: 3000)
# If port is in use, dev server will auto-increment to 3001, 3002, etc.
PORT=3000

# Claude model to use (default: claude-haiku-4-5-20251001)
# Try: claude-3-5-sonnet, claude-opus-4-7, etc.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# System prompt file path (default: prompts/claude-code-system.txt)
# Use this to load a custom system prompt for toio robot control
CLAUDE_SYSTEM_PROMPT_FILE=prompts/claude-code-system.txt

# Auto-approve MCP tool calls in dev mode (default: true)
# Set to "false" for production mode (requires explicit user consent)
# In development, set to "true" to keep UI interactive
CLAUDE_MCP_AUTO_APPROVE=true

# --- LLM Provider Selection ---
# Options: ollama, gemini, claude-code
# claude-code uses the dev-server for streaming responses
LLM_PROVIDER=claude-code

# --- Ollama Settings (if LLM_PROVIDER=ollama) ---
# Ollama API endpoint
OLLAMA_URL=http://localhost:11434
# Model name available in your Ollama instance
OLLAMA_MODEL=gemma4:e4b

# --- Google Gemini Settings (if LLM_PROVIDER=gemini) ---
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here
# Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# --- Camera Integration (Optional) ---
# ESP32S3 camera stream URL for real-time robot vision
CAMERA_URL=http://192.168.1.100:8080
